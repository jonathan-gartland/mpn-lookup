{
  "name": "mpn-lookup",
  "version": "1.2.0",
  "description": "Most Probable Number (MPN) lookups for IDEXX Quanti-Tray, Quanti-Tray/2000 and Legiolert water tests, with typed results and 95% confidence intervals",
  "main": "./dist/mpn.lookup.js",
  "module": "./dist/mpn.lookup.mjs",
  "types": "./dist/mpn.lookup.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "mocha --import=tsx 'test/**/*.test.ts'",
    "tsc": "tsc",
    "prepare": "husky",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint-staged": "lint-staged",
    "format": "prettier --check .",
    "format:fix": "prettier --write --list-different .",
    "type-check": "tsc  --noemit",
    "check-all": "pnpm run lint && pnpm run type-check && pnpm run test",
    "test:ci": "pnpm run test --coverage",
    "test:watch": "pnpm run test --watch",
    "build": "tsup"
  },
  "keywords": [
    "mpn",
    "most-probable-number",
    "idexx",
    "quanti-tray",
    "quantitray",
    "quanti-tray-2000",
    "legiolert",
    "legionella",
    "colilert",
    "coliform",
    "e-coli",
    "enterococci",
    "water-testing",
    "water-quality",
    "microbiology",
    "typescript"
  ],
  "author": {
    "name": "Jonathan Gartland",
    "url": "https://github.com/jonathan-gartland"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.8.0",
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.7.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^8.10.0",
    "chai": "^6.3.0",
    "commitlint": "^21.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^6.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "undici-types": "^8.12.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathan-gartland/mpn-lookup.git"
  },
  "bugs": {
    "url": "https://github.com/jonathan-gartland/mpn-lookup/issues"
  },
  "homepage": "https://github.com/jonathan-gartland/mpn-lookup#readme"
}
